# Copy to .env.local and fill in real values. Never commit real secrets.

# --- Public (inlined into the browser bundle) -------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Must be "true" for Mission Control sign-in to work
NEXT_PUBLIC_FIREBASE_ENABLED=true
# Set to "false" to disable visitor tracking
NEXT_PUBLIC_ANALYTICS_ENABLED=true
NEXT_PUBLIC_SITE_URL=

# --- Server only (never prefix these with NEXT_PUBLIC_) ---------------------
# From the Firebase service account JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the escaped \n sequences
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Email notifications (skipped silently when SMTP_HOST/USER/PASS or NOTIFY_EMAIL are missing)
NOTIFY_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Gmail app password, not your account password
SMTP_PASS=
SMTP_FROM=
