rules_version = '2';

// Public writes go through Next.js API routes using the Admin SDK, which
// bypasses these rules. Browser clients may only read/delete as an admin.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Whitelist: document ID = Firebase Auth UID. Managed in the Console only.
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /contactMessages/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /visitorSessions/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /emailNotifications/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
